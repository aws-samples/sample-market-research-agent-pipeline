# AWS Configuration for Market Research Intelligence App
# Copy this file to .env and fill in your values from CDK stack outputs

# AWS Region
VITE_AWS_REGION=us-east-1

# Cognito User Pool (from FrontendStack outputs)
VITE_COGNITO_USER_POOL_ID=<YOUR_COGNITO_USER_POOL_ID>
VITE_COGNITO_USER_POOL_CLIENT_ID=<YOUR_COGNITO_USER_POOL_CLIENT_ID>

# Cognito Identity Pool (from FrontendStack outputs)
VITE_COGNITO_IDENTITY_POOL_ID=<YOUR_COGNITO_IDENTITY_POOL_ID>

# S3 Buckets (from FrontendStack outputs)
VITE_S3_BUCKET=<YOUR_AGENT_RESULTS_BUCKET>
VITE_ENRICHMENT_KEYWORDS_BUCKET=<YOUR_ENRICHMENT_BUCKET>

# API Gateway URL (from MarketResearchIntelligenceStack outputs)
VITE_AGENT_API_URL=<YOUR_API_GATEWAY_URL>

# Domain config bucket (same as DOMAINS_CONFIG_S3_BUCKET in backend/config.json)
VITE_DOMAINS_CONFIG_BUCKET=<YOUR_PREFIX>-data-sources
